# Copy to .env to override. Bun loads .env from this directory automatically,
# so no dotenv package is involved.
#
#   cp .env.example .env
#
# Every variable below is optional — the values shown are the built-in
# defaults, so the backend runs with no .env at all.

# Port the HTTP server binds to.
PORT=4000

# Origin allowed by CORS. Must match where the Next.js app is served from;
# `apps/web` runs on port 3000.
WEB_ORIGIN=http://localhost:3000

# SQLite database file, relative to packages/backend. It is created on first
# boot, then migrated and seeded with 1000 products automatically.
# Use ":memory:" for a throwaway database that vanishes on exit — that is what
# the test suite uses (see test/preload.ts).
DATABASE_URL=./sqlite.db

# Note: the web app reads NEXT_PUBLIC_API_URL to find this server. It is set in
# apps/web, not here, and must point at http://localhost:${PORT}.
